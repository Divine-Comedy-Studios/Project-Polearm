## Reads the root bone's global transform from _skeleton and assigns its
## basis (as a Quaternion) to _animationPlayer.rootOrientation.
func _update_root_orientation() -> void:
	if not is_instance_valid(_skeleton):
		return
	if not is_instance_valid(_animator):
		return
	if _rootBonePath.is_empty():
		return

	var bone_idx: int = _skeleton.find_bone(_rootBonePath)
	if bone_idx == -1:
		push_warning(
			"EntityAnimationHelper: Bone '%s' not found in skeleton '%s'."
			% [_rootBonePath, _skeleton.name]
		)
		return

	var bone_pose: Transform3D = _skeleton.get_bone_global_pose(bone_idx)
	var orientation: Quaternion = bone_pose.basis.get_rotation_quaternion()

	_animator.rootOrientation = orientation

